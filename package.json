{
  "name": "angular-host-react-remote",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Monorepo with Angular 17+ Host and React Remote via Webpack Module Federation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "concurrently \"npm --workspace=@mfe/host run dev\" \"npm --workspace=@mfe/remote run dev\"",
    "dev:host": "npm --workspace=@mfe/host run dev",
    "dev:remote": "npm --workspace=@mfe/remote run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0"
  }
}
